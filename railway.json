{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "taggy-backend/**",
      "railpack.json",
      "go.work",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "./out",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
