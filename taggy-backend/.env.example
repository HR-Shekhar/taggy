APP_ENV=development
PORT=8080
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5431
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=taggy
DB_SSLMODE=disable

JWT_SECRET=dev-change-me
JWT_ISSUER=taggy-api
JWT_ACCESS_TOKEN_TTL=15m

PASSWORD_BCRYPT_COST=12
AUTH_EMAIL_OTP_TTL=10m

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Optional email (Resend)
RESEND_API_KEY=
RESEND_EMAIL_FROM=

# Optional LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AI roadmap generation (OpenAI-compatible). Prefer NVIDIA NIM (GLM 5.2).
NVIDIA_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=z-ai/glm-5.2
# Optional override: AI_API_KEY=  (same as NVIDIA_API_KEY)

# Legacy OpenRouter fallback (used only if NVIDIA_API_KEY / AI_API_KEY unset)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Comma-separated usernames promoted to is_admin=true on boot
ADMIN_USERNAMES=

# Razorpay Standard Checkout (one-time Taggy Premium unlock)
# Free = 1 active skill; PREMIUM = unlimited. Amount is in paise (49900 = ₹499).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PREMIUM_AMOUNT_PAISE=49900
RAZORPAY_CURRENCY=INR
# Test cards: https://razorpay.com/docs/payments/payments/test-card-details/

# Optional Cloudinary (profile photos). Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
